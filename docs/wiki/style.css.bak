:root {
  --bg: #0b1030;
  --bg2: #121a44;
  --line: rgba(140, 160, 255, .22);
  --fg: #e7ebff;
  --dim: #9fabd9;
  --acc: #6fd8ff;
  --acc2: #b9a6ff;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background:
    radial-gradient(1100px 600px at 15% -10%, #2a1f6b 0%, transparent 60%),
    radial-gradient(900px 500px at 95% 0%, #103b6b 0%, transparent 55%),
    linear-gradient(180deg, #0b1030 0%, #120c2a 60%, #080b1c 100%);
  background-attachment: fixed;
  color: var(--fg);
  font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", system-ui, sans-serif;
  font-size: 16px;
  line-height: 1.75;
}

a { color: var(--acc); text-decoration: none; }
a:hover { text-decoration: underline; }

.top {
  position: sticky; top: 0; z-index: 20;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 28px;
  background: rgba(8, 11, 28, .82);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}

.brand { color: #fff; font-weight: 800; letter-spacing: .5px; }
.brand span { color: var(--acc); font-weight: 600; }

.topnav { display: flex; gap: 18px; font-size: 14px; }

.layout {
  display: flex; gap: 34px;
  max-width: 1280px; margin: 0 auto; padding: 28px 28px 60px;
  align-items: flex-start;
}

.side {
  position: sticky; top: 76px;
  width: 232px; flex: 0 0 232px;
  max-height: calc(100vh - 100px); overflow: auto;
  padding-right: 6px;
}

.side .grp {
  margin: 18px 0 6px;
  font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--dim);
}

.side ul { list-style: none; margin: 0; padding: 0; }
.side li { margin: 2px 0; }
.side li a {
  display: block; padding: 6px 10px; border-radius: 6px;
  color: #cfd6ff; font-size: 14.5px;
}
.side li a:hover { background: rgba(122, 140, 255, .12); text-decoration: none; }
.side li a.on {
  background: rgba(111, 216, 255, .14);
  color: #fff; font-weight: 700;
  box-shadow: inset 2px 0 0 var(--acc);
}

.doc {
  flex: 1 1 auto; min-width: 0;
  background: rgba(18, 26, 68, .55);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 34px 42px 28px;
}

.doc h1 {
  margin: 0 0 18px;
  font-size: 34px; line-height: 1.3;
  background: linear-gradient(92deg, #fff 10%, #b9a6ff 60%, #6fd8ff 95%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}

.doc h2 {
  margin: 34px 0 12px; font-size: 23px;
  padding-bottom: 8px; border-bottom: 1px solid var(--line);
}

.doc h3 { margin: 24px 0 8px; font-size: 18px; color: #dfe6ff; }

.doc p { margin: 10px 0; color: #d9e0ff; }

.doc ul, .doc ol { padding-left: 24px; }
.doc li { margin: 4px 0; }

.doc code {
  background: rgba(111, 216, 255, .12);
  color: #a8f0ff;
  padding: 2px 6px; border-radius: 5px;
  font-family: Consolas, "Cascadia Mono", monospace; font-size: 14px;
}

.doc pre {
  background: #070a1e; border: 1px solid var(--line);
  border-radius: 10px; padding: 14px 16px; overflow: auto;
}
.doc pre code { background: none; color: #cfe3ff; padding: 0; font-size: 13.5px; }

.doc blockquote {
  margin: 16px 0; padding: 10px 16px;
  border-left: 3px solid var(--acc2);
  background: rgba(185, 166, 255, .08);
  color: #cfd6ff; border-radius: 0 8px 8px 0;
}

.doc table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14.5px; }
.doc th, .doc td { border: 1px solid var(--line); padding: 9px 12px; text-align: left; }
.doc th { background: rgba(122, 140, 255, .12); color: #fff; }
.doc tr:nth-child(even) td { background: rgba(255, 255, 255, .02); }

.doc img {
  display: block;
  max-width: 100%;
  max-height: 520px;
  width: auto;
  border-radius: 10px;
  margin: 14px auto;
  border: 1px solid var(--line);
}

.foot {
  margin-top: 44px; padding-top: 16px;
  border-top: 1px solid var(--line);
  font-size: 13px; color: var(--dim);
}

@media (max-width: 900px) {
  .layout { flex-direction: column; }
  .side { position: static; width: 100%; flex: none; max-height: none; }
  .doc { padding: 22px; }
}

